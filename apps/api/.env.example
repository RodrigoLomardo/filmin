PORT=3001

# Ambiente da aplicação: development | production
# Fonte da verdade para guardrails de scripts destrutivos, CORS e logs.
APP_ENV=development

# Postgres. Em dev local, usar o banco da stack Supabase local:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# SSL: true no Supabase hospedado, false no Postgres local.
# Se omitido, é inferido pelo host da DATABASE_URL.
DATABASE_SSL=false

# URLs do frontend aceitas pelo CORS (separadas por vírgula).
FRONTEND_URL=http://localhost:3000

# URL do projeto Supabase — usada para buscar o JWKS e validar tokens ES256.
# Em dev local: http://127.0.0.1:54321
SUPABASE_URL=
# Chave service_role — APENAS em dev, usada pelo script de seed para criar
# usuários de teste no Auth local. Nunca expor no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# TMDB — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Groq — https://console.groq.com/keys
GROQ_API_KEY=
# Google Books
GOOGLE_BOOKS_API_KEY=

# Modo Família do Theo — permite exercitar o comportamento com usuários de teste.
FAMILY_EMAIL_PAI=
FAMILY_EMAIL_MAE=
