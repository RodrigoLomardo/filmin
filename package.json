{
  "name": "filmin",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:web": "npm run dev -w @filmin/web",
    "dev:api": "npm run start:dev -w @filmin/api",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "lint": "npm run lint -ws --if-present",
    "format": "prettier . --write",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:studio": "echo 'Supabase Studio: http://127.0.0.1:54323'",
    "db:migrate": "npm run migration:run -w @filmin/api",
    "db:seed": "npm run seed:dev -w @filmin/api",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:check": "npm run migration:check -w @filmin/api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "supabase": "2.119.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "dependencies": {
    "jose": "^6.2.2"
  }
}
